# Quaxly secrets or this .env file
DISCORD_TOKEN=put_token_here
# Optional fallback. Prefer /admin → 日程調整 → 控えメールの宛先. Never commit .env.
DENSUKE_EMAIL=
GUILD_ID=put_server_id_here
# Lobby / destinations / countdown are configured using /admin → VC設定

# Updates are checked and applied manually via /admin → バージョン管理.
# Legacy ASTRAL_AUTO_UPDATE / ASTRAL_UPDATE_INTERVAL settings are no longer used.

# Backup Zundamon reader: enable Message Content Intent in Developer Portal first.
# Prefer /admin → 運用・管理 → ENV・起動設定, then restart the bot.
# Saved startup settings override the two values below; tokens are never editable there.
# 0 keeps message access disabled.
ASTRAL_BACKUP_TTS=0
# Optional native synthesis threads (1..4; default 2). Benchmark on your own host.
VOICEVOX_BACKUP_THREADS=2
